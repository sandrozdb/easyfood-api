PORT=3000
DATABASE_URL="mysql://usuario:senha@localhost:3306/easyfood"

# App Client público sem Client Secret. O segredo Google fica somente no Cognito.
COGNITO_USER_POOL_ID=us-east-1_SUBSTITUA
COGNITO_CLIENT_ID=SUBSTITUA_PELO_APP_CLIENT_ID
COGNITO_DOMAIN=https://SUBSTITUA.auth.us-east-1.amazoncognito.com
COGNITO_CALLBACK_URL=http://localhost:3000/callback.html
COGNITO_LOGOUT_URL=http://localhost:3000/index.html

# Bucket privado. As credenciais seguem a cadeia padrão do AWS SDK
# (AWS Profile/SSO, role da infraestrutura ou variáveis padrão da AWS).
AWS_S3_REGION=
AWS_S3_BUCKET=

# E-mail transacional. Deixe vazio para desativar sem afetar a aplicação.
MAIL_PROVIDER=mailersend
MAILERSEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=EasyFood
MAIL_TIMEOUT_MS=8000
# Usado somente por npm run test:email-real
MAIL_REAL_TEST_TO=
