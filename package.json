{
  "name": "easyfood-api",
  "version": "1.0.0",
  "private": true,
  "description": "API acadêmica de restaurantes com Node.js, Express, Prisma ORM, MySQL e arquitetura modular documentada por ADRs.",
  "main": "server.js",
  "scripts": {
    "db:setup": "npm run prisma:generate && npm run db:seed",
    "db:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "start": "node server.js",
    "test": "node --test",
    "test:email-real": "node scripts/email-real-check.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "prisma",
    "mysql",
    "rest-api",
    "architecture",
    "adr"
  ],
  "author": "Sandro Ferreira",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@prisma/client": "6.12.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}
